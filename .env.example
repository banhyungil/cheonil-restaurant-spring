# docker-compose 가 자동으로 같은 디렉터리의 .env 를 읽음.
# 실제 값은 .env 파일에 (이 파일은 템플릿 — git 에 커밋됨).

# PostgreSQL 비밀번호 — db 컨테이너(POSTGRES_PASSWORD) + app(SPRING_DATASOURCE_PASSWORD) 공용
DB_PASSWORD=

# Cloudflare Tunnel 토큰 — Zero Trust > Networks > Connectors 에서 발급
CLOUDFLARED_TOKEN=eyJhIjoi...

# Google Cloud API 키 (TTS, STT) — Console > APIs & Services > Credentials 에서 발급
GOOGLE_API_KEY=

# (선택) 배포 이미지 태그 — 롤백 시 각 저장소의 git sha 지정. 미지정 시 latest.
# APP_TAG=   # backend (cheonil-restaurant-spring) sha
# WEB_TAG=   # frontend (cheonil-restaurant-next) sha
